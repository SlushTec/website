---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'Studio' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-surface/70 bg-iron/95 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 h-16 sm:h-[4.25rem] flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group" aria-label="SlushTec home">
      <img
        src="/brand/mark-circular.svg"
        alt=""
        class="w-9 h-9 sm:w-10 sm:h-10 transition duration-200 group-hover:scale-[1.04]"
        width="40"
        height="40"
      />
      <span class="font-semibold tracking-[0.08em] text-lg sm:text-xl leading-none">
        <span class="text-white group-hover:text-gray-100 transition">SLUSH</span><span class="text-golden-glow group-hover:text-warm-earth transition">TEC</span>
      </span>
    </a>
    <nav class="flex items-center gap-6 sm:gap-8 text-sm tracking-wide">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-gray-400 hover:text-warm-earth transition"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
