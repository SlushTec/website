---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects — SlushTec"
  description="VARP and Ashcourt: the core projects of SlushTec. Permanent residual systems and original-IP dark fantasy."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-semibold text-golden-glow mb-12">Projects</h1>

    <article id="varp" class="mb-16 scroll-mt-24">
      <h2 class="text-2xl font-medium text-white mb-3">VARP</h2>
      <p class="text-warm-earth text-sm mb-4">Virtual Action Role Play · Active development</p>
      <p class="text-gray-300 leading-relaxed max-w-3xl">
        A modular, local-first Virtual LARP engine. Players act freely inside reactive mini-universes
        whose inhabitants keep permanent score. Features the True Emotion Engine, soul-bound residual systems,
        and original World Packs. Adult (18+).
      </p>
      <p class="mt-4 text-sm text-gray-500">
        <!-- TODO: public repo or Steam page when ready -->
        Development is private. Public surfaces will open when the vertical slice is ready to share.
      </p>
    </article>

    <article id="ashcourt" class="mb-16 scroll-mt-24">
      <h2 class="text-2xl font-medium text-white mb-3">Ashcourt — Hell Rises</h2>
      <p class="text-warm-earth text-sm mb-4">Original-IP dark fantasy · Parallel track</p>
      <p class="text-gray-300 leading-relaxed max-w-3xl">
        Narrative action RPG set in the same universe as the flagship VARP World Pack.
        Modern hell, permanent residual, and the Threshold Annex. Commercial original IP only.
      </p>
    </article>
  </section>
</BaseLayout>
