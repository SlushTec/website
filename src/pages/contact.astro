---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — SlushTec"
  description="Contact SlushTec. Studio inquiries, press, and partnership. Tucson, Arizona."
>
  <section class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-16 sm:py-24">
    <p class="text-warm-earth text-sm font-medium tracking-[0.2em] uppercase mb-4">
      Get in touch
    </p>
    <h1 class="text-4xl sm:text-5xl font-semibold text-white tracking-tight mb-6">Contact</h1>
    <div class="score-line max-w-xs mb-12"></div>

    <div class="grid sm:grid-cols-2 gap-12 max-w-3xl">
      <div>
        <p class="text-gray-400 text-base mb-2">Studio / press / partnership</p>
        <a
          href="mailto:brian@slushtec.com"
          class="text-xl text-warm-earth hover:text-golden-glow transition font-medium"
        >
          brian@slushtec.com
        </a>
      </div>
      <div>
        <p class="text-gray-400 text-base mb-2">Location</p>
        <p class="text-gray-200 text-lg">Tucson, Arizona, US</p>
      </div>
    </div>

    <p class="mt-14 text-base text-gray-500 max-w-md">
      Adult 18+ projects only. We do not accept unsolicited franchise or IP adaptation proposals.
    </p>
  </section>
</BaseLayout>
