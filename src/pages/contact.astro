---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — SlushTec"
  description="Contact SpushTec. Studio inquiries, press, and partnership."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <h1 class="text-3xl sm:text-4xl font-semibold text-golden-glow mb-6">Contact</h1>
    <p class="text-gray-300 mb-8 leading-relaxed">
      For studio inquiries, press, or partnership:
    </p>
    <div class="space-y-4 text-lg">
      <p>
        <a href="mailto:brian@slushtec.com" class="text-warm-earth hover:text-golden-glow transition">
          brian@slushtec.com
        </a>
      </p>
      <p class="text-sm text-gray-500">
        Tucson, Arizona, US
      </p>
    </div>
  </section>
</BaseLayout>
